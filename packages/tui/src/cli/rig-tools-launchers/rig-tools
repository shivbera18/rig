#!/bin/sh
set -eu
runtime_executable=${__RIG_RIG_TOOLS_RUNTIME_EXECUTABLE:-}
if [ -z "$runtime_executable" ]; then
  echo "Rig rig-tools runtime is unavailable. Restart Rig." >&2
  exit 1
fi
rig_tools_bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$runtime_executable" "$rig_tools_bin_dir/../rig-tools.js" "$@"
